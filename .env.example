DB_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/fitness_db
ACCESS_TOKEN_SECRET_KEY=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET_KEY=replace-with-another-long-random-secret
ALGORITHM=HS256

# Local model: run Ollama and pull the exact LLM_MODEL first.
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT=15
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.4

# Leave these defaults for normal local use. render.yaml configures a separate demo.
DEMO_MODE=false
MODEL_RETRAIN_ENABLED=true
# Hosted instruct models can optionally use LLM_REASONING_EFFORT=none.
