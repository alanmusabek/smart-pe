FROM node:22-slim AS frontend
WORKDIR /web
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-server.txt ./
RUN pip install --no-cache-dir -r requirements-server.txt
# Explicit inputs keep local databases, reports, logs, and .env out of the image.
COPY auth.py main.py schemas.py feature_extractor.py plan_assembler.py explainability.py retrain.py ./
COPY core ./core
COPY routers ./routers
COPY chatbot ./chatbot
COPY deployment ./deployment
COPY fitness_ranker.pkl ./
COPY --from=frontend /web/dist ./frontend/dist
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
EXPOSE 10000
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
